<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/CubeUI/CubeUIStyleSheet.uss?fileID=7433441132597879392&amp;guid=8ed8fc0095e5b2040ab7815fa7370d32&amp;type=3#CubeUIStyleSheet"/>
    <ui:VisualElement name="MainFoldout" style="flex-grow: 1; -unity-font-style: bold-and-italic; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); transition-timing-function: ease-in-out; transition-delay: 0.25s;">
        <ui:Foldout text="Cube Settings" style="align-items: stretch; align-self: auto; align-content: stretch; cursor: initial;">
            <ui:VisualElement name="ButtonContainer" style="flex-grow: 0; flex-direction: row; align-items: center; align-self: center; align-content: flex-start;">
                <ui:Button text="Spin" name="SpinButton" class="button"/>
                <ui:Button text="Rotate" name="RotateButton" class="button"/>
                <ui:Button text="Stop" name="StopButton" class="button"/>
                <ui:Button text="Reset" name="ResetButton" class="button"/>
            </ui:VisualElement>
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
